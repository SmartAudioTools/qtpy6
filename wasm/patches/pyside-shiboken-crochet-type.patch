# qtpy6 : crochet Python appelé par shiboken à chaque création de type (Shiboken.setTypeCreationHook).
# C'est ce qui permet à qtpy6 de poser ses alias snake_case classe par classe, à la demande, y compris sur les
# classes qu'aucun code n'a nommées (objets rendus par Qt). Voir notes/2026-09-30 - PySide6 en WebAssembly.md.
diff --git a/sources/shiboken6/libshiboken/sbkmodule.cpp b/sources/shiboken6/libshiboken/sbkmodule.cpp
index c2d2009..d5d674b 100644
--- a/sources/shiboken6/libshiboken/sbkmodule.cpp
+++ b/sources/shiboken6/libshiboken/sbkmodule.cpp
@@ -37,12 +37,34 @@ using ModuleToFuncsMap = std::unordered_map<PyObject *, NameToTypeFunctionMap> ;
 static ModuleTypesMap moduleTypes;
 static ModuleConvertersMap moduleConverters;
 static ModuleToFuncsMap moduleToFuncs;
+/// qtpy6: see setTypeCreationHook().
+static PyObject *typeCreationHook{};
 
 namespace Shiboken
 {
 namespace Module
 {
 
+void setTypeCreationHook(PyObject *callable)
+{
+    if (callable == Py_None)
+        callable = nullptr;
+    Py_XINCREF(callable);
+    Py_XDECREF(typeCreationHook);
+    typeCreationHook = callable;
+}
+
+// qtpy6: called at the end of incarnateHelper() and incarnateType(), the two places every
+// type goes through (module attribute, star import, converter lookup, nested types).
+static void notifyTypeCreated(PyTypeObject *type)
+{
+    if (typeCreationHook == nullptr || type == nullptr)
+        return;
+    AutoDecRef ret(PyObject_CallOneArg(typeCreationHook, reinterpret_cast<PyObject *>(type)));
+    if (ret.isNull())
+        PyErr_WriteUnraisable(typeCreationHook);  // never let the hook break a type creation
+}
+
 // PYSIDE-2404: Replacing the arguments generated by cpythonTypeNameExt
 //              by a function call.
 LIBSHIBOKEN_API PyTypeObject *get(TypeInitStruct &typeStruct)
@@ -105,6 +127,7 @@ static void incarnateHelper(PyObject *module, const std::string_view names,
     auto name = names.substr(startPos);
     AutoDecRef nameP(PyUnicode_FromStringAndSize(name.data(), name.size()));
     PyObject_SetAttr(modOrType, nameP, reinterpret_cast<PyObject *>(type));
+    notifyTypeCreated(type);
 }
 
 static void incarnateSubtypes(PyObject *module,
@@ -145,6 +168,7 @@ static PyTypeObject *incarnateType(PyObject *module, const std::string &name,
     // - remove the entry, if not by something cleared.
     if (!nameToFunc.empty())
         nameToFunc.erase(funcIter);
+    notifyTypeCreated(type);
     // - return the PyTypeObject.
     return type;
 }
