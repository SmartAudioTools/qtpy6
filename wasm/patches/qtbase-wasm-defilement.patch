+// Scrolling moves the already painted pixels inside m_image (as QRasterBackingStore does) so that
+// QWidgetRepaintManager only repaints the newly exposed strip instead of the whole scrolled area.
+// The moved area is then flushed by the repaint manager, which marks it dirty for updateTexture().
+bool QWasmBackingStore::scroll(const QRegion &area, int dx, int dy)
+{
+    if (m_image.isNull() || !QPlatformSurface::isRasterSurface(window()))
+        return false;
+
+    extern void qt_scrollRectInImage(QImage &, const QRect &, const QPoint &);
+
+    const qreal dpr = m_image.devicePixelRatio();
+    const QPoint delta(qRound(dx * dpr), qRound(dy * dpr));
+    const QRect rect = area.boundingRect();
+    qt_scrollRectInImage(m_image, QRect(rect.topLeft() * dpr, rect.size() * dpr), delta);
+    return true;
+}
