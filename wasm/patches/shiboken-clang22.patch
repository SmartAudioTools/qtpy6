+// Clang 22 : clang_getTypeSpelling() ne rend plus le nom qualifié. Repris de l'amont (PYSIDE-3286, 27cb9ca,
+// shiboken 6.11.1), en plus court : la politique d'affichage est globale, posée par parse(), au lieu d'être
+// passée à chaque appel.
+static CXPrintingPolicy printingPolicy = nullptr;
+
+void setPrintingPolicy(CXPrintingPolicy p)
+{
+    printingPolicy = p;
+}
+
+// Nom qualifié d'une déclaration par la chaîne de ses parents sémantiques (« QList::const_reference »).
+static QString cursorScopedName(const CXCursor &decl)
+{
+    QString result;
+    for (CXCursor c = decl; !clang_isTranslationUnit(c.kind) && !clang_Cursor_isNull(c)
+         && !clang_isInvalid(c.kind); c = clang_getCursorSemanticParent(c)) {
+        const QString name = getCursorSpelling(c);
+        if (!name.isEmpty())
+            result.prepend(result.isEmpty() ? name : name + u"::"_s);
+    }
+    return result;
+}
+
+static bool isInClassTemplate(CXCursor c)
+{
+    for (c = clang_getCursorSemanticParent(c); !clang_Cursor_isNull(c) && !clang_isInvalid(c.kind)
+         && !clang_isTranslationUnit(c.kind); c = clang_getCursorSemanticParent(c)) {
+        if (c.kind == CXCursor_ClassTemplate || c.kind == CXCursor_ClassTemplatePartialSpecialization)
+            return true;
+    }
+    return false;
+}
+
 QString getTypeName(const CXType &type)
 {
-    CXString typeSpelling = clang_getTypeSpelling(type);
-    const QString result = QString::fromUtf8(clang_getCString(typeSpelling));
+    // Un typedef ou une classe imbriquée DANS un modèle de classe : clang_getFullyQualifiedName() le qualifie avec
+    // la dernière instanciation rencontrée (« QList<QString>::const_reference » au lieu de « QList::const_reference »,
+    // mesuré sur libclang 22.1.8), ce qui fait générer QItemSelection::at() en « QItemSelectionRange<QString> ».
+    // On reconstruit alors la forme qu'avait clang 21, sans arguments d'instanciation.
+    if (printingPolicy != nullptr && (type.kind == CXType_Typedef || type.kind == CXType_Record)) {
+        const CXCursor decl = clang_getTypeDeclaration(type);
+        if (isInClassTemplate(decl)) {
+            const QString name = cursorScopedName(decl);
+            return clang_isConstQualifiedType(type) != 0 ? u"const "_s + name : name;
+        }
+    }
+    CXString typeSpelling = printingPolicy != nullptr
+        ? clang_getFullyQualifiedName(type, printingPolicy, 0) : clang_getTypeSpelling(type);
+    QString result = QString::fromUtf8(clang_getCString(typeSpelling));
     clang_disposeString(typeSpelling);
+    if (result.startsWith(u"struct "))  // clang_getFullyQualifiedName() garde le mot-clé (comme l'amont 6.11)
+        result.remove(0, 7);
     return result;
 }
 
