diff --git a/qtpy6/web/ramasse_miettes.py b/qtpy6/web/ramasse_miettes.py
new file mode 100644
index 0000000..996a305
--- /dev/null
+++ b/qtpy6/web/ramasse_miettes.py
@@ -0,0 +1,49 @@
+"""Le ramasse-miettes de Python ne passe plus au hasard d'une allocation, mais quand l'hôte le décide : entre deux
+événements de Qt dans l'application (``qtpy6.web._ramasser``, toutes les plates-formes), au réveil d'une minuterie de la
+boucle asyncio dans le Worker de ``ProcessusWeb`` (``preambule._doubler_gc``). Python pur, sans Qt ni ``js`` : le même
+module des deux côtés (copié dans le Worker, ``travailleur._FICHIERS_WORKER``).
+
+    couper()                 GC automatique coupé ; ``gc.enable``/``disable``/``isenabled`` ne règlent plus que les
+                             passes de ``passer`` (parso fait ``gc.enable()`` dans un ``finally`` : sans la doublure, il
+                             rallume le GC automatique)
+    passer(complete, seuil)  une passe si le GC est « actif » et que les compteurs l'auraient déclenchée"""
+
+from __future__ import annotations
+
+import gc
+
+_actif = [True]
+_seuils = gc.get_threshold()
+_vrais = (gc.enable, gc.disable, gc.isenabled)
+
+
+def _enable() -> None:
+    _actif[0] = True
+
+
+def _disable() -> None:
+    _actif[0] = False
+
+
+def _isenabled() -> bool:
+    return _actif[0]
+
+
+def couper() -> None:
+    """Idempotent : un second appel (page puis Worker dans un même processus de test) ne double pas la doublure."""
+    if gc.isenabled is not _isenabled:
+        _actif[0] = _vrais[2]()
+        gc.enable, gc.disable, gc.isenabled = _enable, _disable, _isenabled
+    _vrais[1]()
+
+
+def passer(complete: bool = False, seuil: int | None = None) -> None:
+    """Rien si l'application a « coupé » le GC (``gc.disable()``). Sinon, si plus de ``seuil`` objets sont nés depuis la
+    dernière passe (par défaut le premier seuil de Python) : passe complète si ``complete``, sinon la génération que
+    Python aurait ramassée lui-même."""
+    if not _actif[0]:
+        return
+    n0, n1, n2 = gc.get_count()
+    if n0 <= (_seuils[0] if seuil is None else seuil):
+        return
+    gc.collect(2 if complete or n2 > _seuils[2] else 1 if n1 > _seuils[1] else 0)
