+def _doubler_gc(boucle: asyncio.AbstractEventLoop, periode_s: float = 2.0, seuil: int = 20000) -> None:
+    """Les passes AUTOMATIQUES du ramasse-miettes de Python 3.14 tuent le Worker (« index out of bounds » dans le GC)
+    dès que des piles JSPI se sont entrelacées (fils émulés, ``time.sleep``) ; ``gc.collect()``, passe complète, jamais
+    (12/10/2026 : ``gc.set_threshold(1, 1, 1)`` dans le noyau meurt à la première allocation, ``gc.collect()`` après
+    chaque pas passe ; Pyodide nu, sans piles entrelacées, passe les deux). Le GC automatique reste donc coupé, et une
+    passe complète a lieu toutes les ``periode_s`` secondes si plus de ``seuil`` objets sont nés depuis la dernière.
+    ``gc.enable``/``disable``/``isenabled`` ne règlent plus que ces passes (parso réactive le GC sans condition)."""
+    import gc  # noqa: PLC0415
+
+    actif = [gc.isenabled()]
+    gc.disable()
+
+    def enable() -> None:
+        actif[0] = True
+
+    def disable() -> None:
+        actif[0] = False
+
+    def passe() -> None:
+        if actif[0] and gc.get_count()[0] > seuil:
+            gc.collect()
+        boucle.call_later(periode_s, passe)
+
+    gc.enable, gc.disable, gc.isenabled = enable, disable, lambda: actif[0]
+    boucle.call_later(periode_s, passe)
+
+
